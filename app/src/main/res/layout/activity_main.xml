<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. CameraX Live Camera Feed View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 2. Dashcam Test Video Feed View -->
    <TextureView
        android:id="@+id/textureVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/ivVideoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 3. Unified Realtime Vision Overlay (Lanes + Vehicle Boxes + Live Log Console) -->
    <com.vadas.app.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 4. Thanh điều khiển tối giản (Chỉ giữ chuyển nguồn phát và ẩn/hiện log) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/llControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Switch between CameraX and Dashcam Video -->
            <Button
                android:id="@+id/btnCameraXMode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_hud_pill_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="📷 CameraX ADAS"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:textSize="14sp" />

            <!-- Toggle Live Log Console -->
            <Button
                android:id="@+id/btnToggleLog"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_hud_pill_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="📝 Ẩn/Hiện Log"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
